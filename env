#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# Zona waktu aplikasi. Default di kode: Asia/Makassar (WITA, UTC+8).
# Nilai ini dipakai date()/Time CI4 untuk MENULIS ke database, jadi jangan
# diubah ke UTC — data akan mundur 8 jam. Bila pernah berjalan dengan UTC,
# jalankan `php spark eult:waktu --dry-run` lalu `php spark eult:waktu`.
# app.appTimezone = Asia/Makassar

#--------------------------------------------------------------------
# UPLOAD
#--------------------------------------------------------------------

# Batas ukuran berkas unggahan dalam MB (default 10).
# HANYA batas sisi aplikasi. Batas PHP (upload_max_filesize, post_max_size)
# dan nginx (client_max_body_size) harus >= nilai ini, kalau tidak berkas
# dipotong sebelum sampai ke kode. Lihat docs/deploy.md.
# EULT_UPLOAD_MAX_MB = 10

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# Masa berlaku sesi dalam detik (default 28800 = 8 jam).
# session.expiration = 28800

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Kunci framework CI4 (wajib unik per instalasi; generate via `php spark key:generate`).
# Dipakai sebagai fallback Enkripsi tiket bila EULT_ENCRYPTION_LEGACY_KEY kosong.
# encryption.key =

# Kunci enkripsi tautan tiket (cektiket/validitas) — WAJIB diisi di production
# dengan nilai acak kuat (mis. `openssl rand -hex 32`). Prioritas utama;
# bila kosong, dipakai encryption.key di atas. Tautan lama yang dibuat dengan
# kunci berbeda menjadi invalid setelah kunci diganti.
# EULT_ENCRYPTION_LEGACY_KEY =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null
# Masa berlaku sesi (detik). Default kode 28800 = 8 jam.
# session.expiration = 28800

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# DATABASE — kredensial WAJIB diisi di production (dipakai Config\Database).
#--------------------------------------------------------------------

# Database utama aplikasi.
# EULT_DB_HOST = 127.0.0.1
# EULT_DB_PORT = 3306
# EULT_DB_NAME = db_eultunmul
# EULT_DB_USER =
# EULT_DB_PASS =

# Database referensi layanan (ref_layanan/jenis/unit) — dipakai getLayanan()
# dan seluruh JOIN lintas DB. User DB harus punya SELECT ke database ini,
# dan FK d_ticketing/r_berkas_layanan/t_surat harus menunjuk ke sini
# (bukan ke nama lama `db_ult`).
# EULT_DBULT_HOST = 127.0.0.1
# EULT_DBULT_PORT = 3306
# EULT_DBULT_NAME = db_ultunmul
# EULT_DBULT_USER =
# EULT_DBULT_PASS =

#--------------------------------------------------------------------
# EMAIL SMTP — WAJIB diisi di production (dipakai Config\Email).
# Tanpa EULT_MAIL_PASS, notifikasi tiket (savetiket/validasi) gagal auth.
# Untuk Gmail wajib App Password (bukan password login), akun perlu
# 2-Step Verification aktif. Host TANPA prefix ssl:///tls://.
#--------------------------------------------------------------------

# EULT_MAIL_HOST = smtp.gmail.com
# EULT_MAIL_PORT = 465
# EULT_MAIL_USER = tiketult@unmul.ac.id
# EULT_MAIL_PASS =
# EULT_MAIL_FROM = tiketult@unmul.ac.id
# EULT_MAIL_NAME = EULT UNMUL

#--------------------------------------------------------------------
# OSM UNMUL — kredensial API verifikasi identitas (dipakai OsmClient).
# Tanpa ini, cek NIM/NIP gagal dan kategori layanan tidak terbuka.
#--------------------------------------------------------------------

# EULT_OSM_URL = https://osm.unmul.ac.id
# EULT_OSM_PLPKKN_USER =
# EULT_OSM_PLPKKN_PASS =
# EULT_OSM_PLPKKN_KEY =
# EULT_OSM_SIMKEU_USER =
# EULT_OSM_SIMKEU_PASS =
# EULT_OSM_SIMKEU_KEY =
# EULT_OSM_BAHASA_USER =
# EULT_OSM_BAHASA_PASS =
# EULT_OSM_BAHASA_KEY =

#--------------------------------------------------------------------
# DATA BISNIS EULT (opsional — nilai bawaan ada di kode)
#--------------------------------------------------------------------

# Pejabat penandatangan surat EKTMI (Ticketing::validasiEktm).
# EULT_EKTMI_PEJABAT_NAMA = 'Nama Pejabat, Gelar'
# EULT_EKTMI_PEJABAT_NIP = '19...'
# EULT_EKTMI_PEJABAT_JABATAN = 'Koordinator Unit Layanan Terpadu'

# Daftar ID layanan khusus untuk pemohon internal (ModelMaster::getLayanan),
# dipisah koma.
# EULT_LAYANAN_KHUSUS = '9,12,32,45,78,88,110,27,28,29,146,150,168'

#--------------------------------------------------------------------
# CHECKLIST PRODUCTION — pastikan seluruh blok WAJIB di atas terisi
# di file .env server (file ini hanya template, tidak dibaca aplikasi):
#  [ ] CI_ENVIRONMENT = production, app.baseURL = URL publik
#  [ ] app.appTimezone = Asia/Makassar (WITA) — jangan UTC
#  [ ] upload_max_filesize & post_max_size PHP >= EULT_UPLOAD_MAX_MB
#  [ ] session.expiration sesuai kebutuhan (default 8 jam)
#  [ ] encryption.key (unik, via `php spark key:generate`)
#  [ ] EULT_ENCRYPTION_LEGACY_KEY (opsional bila encryption.key sudah ada;
#      isi bila ingin kunci tautan tiket terpisah dari kunci framework)
#  [ ] EULT_DB_* (database utama) + EULT_DBULT_* (database referensi)
#  [ ] EULT_MAIL_* lengkap termasuk EULT_MAIL_PASS (App Password Gmail)
#  [ ] EULT_OSM_* (URL + 3 set kredensial: PLPKKN, SIMKEU, BAHASA)
#  [ ] User DB punya SELECT ke db utama + db referensi; FK menunjuk
#      ke database referensi yang sama dengan EULT_DBULT_NAME
#--------------------------------------------------------------------
