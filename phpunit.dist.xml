<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
    backupGlobals="false"
    beStrictAboutOutputDuringTests="true"
    colors="true"
    columns="max"
    failOnRisky="true"
    failOnWarning="true"
    cacheDirectory="build/.phpunit.cache"
    defaultTestSuite="Unit"
>
    <coverage pathCoverage="false" ignoreDeprecatedCodeUnits="true">
        <report>
            <clover outputFile="build/logs/clover.xml"/>
            <html outputDirectory="build/logs/html"/>
            <php outputFile="build/logs/coverage.serialized"/>
            <text outputFile="php://stdout" showUncoveredFiles="false"/>
        </report>
    </coverage>

    <!--
        Suite dipisah menurut infrastruktur yang dibutuhkan:
        Unit     : mandiri (tanpa MySQL/server), dijalankan default dan di CI.
        Database : butuh MySQL db_newtiket + db_ult (kredensial .env EULT_DB_*).
        Live     : menembak server dev live / menjalankan subprocess php built-in server.
        Jalankan suite lain dengan: vendor/bin/phpunit testsuite Database
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory>./tests/unit</directory>
            <directory>./tests/session</directory>
            <file>./tests/Bugfix/AdminCspAssetsPreservationTest.php</file>
            <file>./tests/Bugfix/CspFirstPartyNoncePreservationTest.php</file>
            <file>./tests/Bugfix/R1EscBindingAuditExplorationTest.php</file>
            <file>./tests/Bugfix/R1EscPreservationTest.php</file>
            <exclude>./tests/unit/AksesBerkasTest.php</exclude>
            <exclude>./tests/unit/AlurFondasiTest.php</exclude>
            <exclude>./tests/unit/EksporTiketTest.php</exclude>
            <exclude>./tests/unit/PublicPortalViewsTest.php</exclude>
        </testsuite>
        <testsuite name="Database">
            <directory>./tests/database</directory>
            <file>./tests/unit/AksesBerkasTest.php</file>
            <file>./tests/unit/AlurFondasiTest.php</file>
            <file>./tests/unit/EksporTiketTest.php</file>
            <file>./tests/unit/PublicPortalViewsTest.php</file>
            <file>./tests/Bugfix/K1SqlInjectionExplorationTest.php</file>
            <file>./tests/Bugfix/K1SqlInjectionPreservationTest.php</file>
            <file>./tests/Bugfix/KunciTidakValidTidakMenyentuhDataTest.php</file>
            <file>./tests/Bugfix/K2M2IdorExplorationTest.php</file>
            <file>./tests/Bugfix/K2T4M2PreservationTest.php</file>
            <file>./tests/Bugfix/Klaster3PreservationTest.php</file>
            <file>./tests/Bugfix/M1SecurityHeadersExplorationTest.php</file>
            <file>./tests/Bugfix/M3TicketEnumerationExplorationTest.php</file>
            <file>./tests/Bugfix/T1CsrfExplorationTest.php</file>
            <file>./tests/Bugfix/T2CaptchaRateLimitExplorationTest.php</file>
            <file>./tests/Bugfix/T2M3RateLimitHttpIntegrationTest.php</file>
            <file>./tests/Bugfix/T3CookieCaptchaBypassExplorationTest.php</file>
            <file>./tests/Bugfix/T4RatingOwnershipExplorationTest.php</file>
        </testsuite>
        <testsuite name="Live">
            <file>./tests/Bugfix/CektiketUploadPdfOnlyHttpIntegrationTest.php</file>
            <file>./tests/Bugfix/K1SqlInjectionHttpIntegrationTest.php</file>
            <file>./tests/Bugfix/K3EncryptionFallbackExplorationTest.php</file>
            <file>./tests/Bugfix/K4DebugToolbarExplorationTest.php</file>
            <file>./tests/Bugfix/Klaster3IntegrasiAntarFixHttpIntegrationTest.php</file>
            <file>./tests/Bugfix/Klaster4PreservationTest.php</file>
            <file>./tests/Bugfix/M1CspHeaderHttpIntegrationTest.php</file>
            <file>./tests/Bugfix/T1CsrfAjaxGracefulHandlerHttpIntegrationTest.php</file>
            <file>./tests/Bugfix/T2CaptchaImageHttpIntegrationTest.php</file>
            <file>./tests/Bugfix/T4RatingHttpIntegrationTest.php</file>
        </testsuite>
    </testsuites>

    <logging>
        <testdoxHtml outputFile="build/logs/testdox.html"/>
        <testdoxText outputFile="build/logs/testdox.txt"/>
        <junit outputFile="build/logs/logfile.xml"/>
    </logging>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
        <exclude>
            <directory suffix=".php">./app/Views</directory>
            <file>./app/Config/Routes.php</file>
        </exclude>
    </source>

    <php>
        <server name="app.baseURL" value="http://example.com/"/>
        <server name="CODEIGNITER_SCREAM_DEPRECATIONS" value="0"/>
        <!-- Directory containing phpunit.xml -->
        <const name="HOMEPATH" value="./"/>
        <!-- Directory containing the Paths config file -->
        <const name="CONFIGPATH" value="./app/Config/"/>
        <!-- Directory containing the front controller (index.php) -->
        <const name="PUBLICPATH" value="./public/"/>
        <!-- Database configuration -->
        <!-- Uncomment to provide your own database for testing
            <env name="database.tests.hostname" value="localhost"/>
            <env name="database.tests.database" value="tests"/>
            <env name="database.tests.username" value="tests_user"/>
            <env name="database.tests.password" value=""/>
            <env name="database.tests.DBDriver" value="MySQLi"/>
            <env name="database.tests.DBPrefix" value="tests_"/>
            -->
    </php>
</phpunit>
